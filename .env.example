# Copy this file to .env.local and fill in real values. Never commit .env.local.

# --- Supabase (Settings > API in your Supabase project) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — bypasses RLS. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Database (Settings > Database > Connection string, "Transaction" pooler, port 6543) ---
DATABASE_URL=postgres://postgres.xxxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# --- App ---
# Used to build the magic-link callback URL. http://localhost:3000 in dev.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Comma-separated list of admin e-mail addresses.
ADMIN_EMAILS=you@example.com
# "lime" or "gold" — the app's single accent color (see PLAN.md §7).
NEXT_PUBLIC_ACCENT_THEME=lime

# --- Sportsbook / cron ---
# The Odds API key (free tier, 500 credits/month) — https://the-odds-api.com
# Required for the admin "Week importeren" flow and the odds-import/results cron routes.
ODDS_API_KEY=
# Shared secret checked by /api/cron/* routes (Vercel Cron sends it automatically as a header — see README's Cron section).
CRON_SECRET=
# "highest" (default), "average", or "reference:<bookmaker-key>" — see §5.3.
ODDS_AGGREGATION_STRATEGY=highest

# --- e-mail (Resend) ---------------------------------------------------------
# Zonder RESEND_API_KEY wordt er niets verstuurd: de app logt een waarschuwing
# en draait gewoon door, zodat lokaal ontwikkelen geen mailaccount vereist.
RESEND_API_KEY=
# Waar meldingen over te controleren betalingen naartoe gaan. Los van
# ADMIN_EMAILS, dat bepaalt wie toegang heeft tot /admin.
ADMIN_NOTIFY_EMAIL=
# Moet een adres zijn op een in Resend geverifieerd domein.
EMAIL_FROM="League of Gamblers <noreply@leagueofgamblers.nl>"
